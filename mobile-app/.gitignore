# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Ruflo
.claude-flow/
.swarm/
claude-flow.config.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.production

# Store credentials — never commit (pre-live review 2026-08-06, finding A4)
# eas.json references ./playstore-service-account.json; prefer EAS secret
*-service-account*.json
*.keystore

# Firebase config (contains credentials)
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# testing
coverage/

# generated native folders
/ios
/android
