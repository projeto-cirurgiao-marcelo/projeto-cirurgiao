node_modules
dist
.git
.gitignore
*.md
.env
.env.*
*.log
npm-debug.log*
coverage
.nyc_output
.DS_Store
uploads/*
!uploads/.gitkeep
test
*.spec.ts
jest.config.js

# Secrets — never bake into the image. Firebase Admin loads credentials at
# runtime via FIREBASE_SERVICE_ACCOUNT_KEY (Secret Manager) or ADC.
firebase-service-account.json
*service-account*.json
*.pem
*.key

# Dumps de banco — PII de aluno. Nao entram nem na stage builder.
# (Sem isto, o `COPY . .` do builder levava o dump pra dentro de uma layer
# intermediaria; a imagem final e multi-stage e so copia dist/, mas nao ha
# razao pro dump chegar la.) Manter em paridade com o .gcloudignore.
# NAO usar `*.sql`: pegaria prisma/migrations/*/migration.sql.
db-backups/
*.dump
cloud-sql-proxy.exe
*.csv
