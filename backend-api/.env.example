
# ============================================
# ANALYTICS — PostHog (Sprint 0 foundation)
# ============================================
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ENABLED=false

# ============================================
# AI SUMMARIES — Vertex AI
# ============================================
# Teto de tokens de saída na geração de resumo (default 8192).
# Respostas cortadas (MAX_TOKENS) são rejeitadas e não consomem geração.
VERTEX_SUMMARY_MAX_OUTPUT_TOKENS=8192

# ============================================
# IN-APP PURCHASE (iOS) — App Store Server
# ============================================
# Não são segredos: identificam o app pra validar o JWS assinado pela Apple.
APPLE_BUNDLE_ID=app.projetocirurgiao.mobile
APPLE_APP_ID=6808997426
# Production | Sandbox (sandbox só em dev/preview; builds de loja usam Production)
APPLE_IAP_ENV=Production
